# Copy to .env and replace the placeholders. Loop does not load .env automatically.
# In bash/zsh: set -a; . ./.env; set +a
OPENAI_API_KEY='replace-with-your-api-key'
OPENAI_MODEL='replace-with-your-model-id'
# Base URL only: do not append /chat/completions.
# Defaults to https://api.openai.com/v1 when unset.
# OPENAI_BASE_URL='https://your-provider.example/v1'

# Example for an existing OpenCode Go account (replace the model/base above):
# OPENAI_MODEL='glm-5.3-flash'
# OPENAI_BASE_URL='https://opencode.ai/zen/go/v1'
