{
  "name": "loop",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "start": "node --use-env-proxy src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "npm run build && npm run typecheck && node --test tests/*.test.ts && node scripts/check_trace_graph.ts",
    "test:docker": "LOOP_TEST_DOCKER=1 node --test tests/coding.test.ts"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": { "@types/node": "24.13.5" },
  "license": "MIT"
}
